            discord.VoiceChannel,
        ):

            await voice.set_permissions(
                member,
                view_channel=True,
                connect=True,
                speak=False if room["silent"] else True,
            )

        await text.set_permissions(
            member,
            view_channel=True,
            send_messages=True,
            read_message_history=True,
        )

