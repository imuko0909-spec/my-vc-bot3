def save_room(
    voice_id: int,
    text_id: int,
    owner_id: int,
    max_members: int,
    silent: bool,
    locked: bool = False,
):
    with db_connect() as conn:
        conn.execute(
            """
            INSERT OR REPLACE INTO rooms
            (voice_id, text_id, owner_id, max_members, silent, locked)
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                voice_id,
                text_id,
                owner_id,
                max_members,
                int(silent),
                int(locked),
            ),
        )
        conn.commit()


def get_room(voice_id: int):
    with db_connect() as conn:
        return conn.execute(
            "SELECT * FROM rooms WHERE voice_id = ?",
            (voice_id,),
        ).fetchone()


def get_room_by_text(text_id: int):
    with db_connect() as conn:
        return conn.execute(
            "SELECT * FROM rooms WHERE text_id = ?",
            (text_id,),
        ).fetchone()


def delete_room_record(voice_id: int):
    with db_connect() as conn:
        conn.execute(
            "DELETE FROM rooms WHERE voice_id = ?",
            (voice_id,),
        )
        conn.commit()


def update_room_lock(voice_id: int, locked: bool):
    with db_connect() as conn:
        conn.execute(
            "UPDATE rooms SET locked = ? WHERE voice_id = ?",
            (int(locked), voice_id),
        )
        conn.commit()


def update_room_limit(voice_id: int, limit: int):
    with db_connect() as conn:
        conn.execute(
            "UPDATE rooms SET max_members = ? WHERE voice_id = ?",
            (limit, voice_id),
        )
        conn.commit()


def cache_profile(user_id: int, channel_id: int, message_id: int):
    with db_connect() as conn:
        conn.execute(
            """
            INSERT OR REPLACE INTO profile_cache
            (user_id, channel_id, message_id)
            VALUES (?, ?, ?)
            """,
            (user_id, channel_id, message_id),
        )
        conn.commit()


def get_cached_profile(user_id: int):
    with db_connect() as conn:
        return conn.execute(
            """
            SELECT * FROM profile_cache
            WHERE user_id = ?
            """,
            (user_id,),
        ).fetchone()


def clear_profile_cache(user_id: int):
    with db_connect() as conn:
        conn.execute(
            "DELETE FROM profile_cache WHERE user_id = ?",
            (user_id,),
        )
        conn.commit()


