class InviteModal(
    discord.ui.Modal,
    title="🍬 メンバー招待",
):

    target = discord.ui.TextInput(
        label="ユーザーID または メンション",
        placeholder="例：123456789012345678",
        max_length=50,
    )

    async def on_submit(
        self,
        interaction: discord.Interaction,
    ):

        if not isinstance(
            interaction.channel,
            discord.TextChannel,
        ):
            return

        room = get_room_by_text(
            interaction.channel.id
        )

        if not room:

            await interaction.response.send_message(
                "❌ 部屋情報が見つかりません。",
                ephemeral=True,
            )

            return

        if not owner_or_admin(
            interaction.user,
            room,
        ):

            await interaction.response.send_message(
                "❌ 部屋主のみ操作できます。",
                ephemeral=True,
            )

            return

        ids = re.findall(
            r"\d{15,22}",
            self.target.value,
        )

        if not ids:

            await interaction.response.send_message(
                "❌ 正しいユーザーIDまたはメンションを入力してください。",
                ephemeral=True,
            )

            return

        user_id = int(
            ids[0]
        )

