# =========================================================

@bot.event
async def on_voice_state_update(
    member: discord.Member,
    before: discord.VoiceState,
    after: discord.VoiceState,
):

    # 入室
    if (
        after.channel
        and after.channel != before.channel
    ):

        room = get_room(
            after.channel.id
        )

        if room:

            task = delete_tasks.pop(
                after.channel.id,
                None,
            )

            if task:
                task.cancel()

            text = member.guild.get_channel(
                room["text_id"]
            )

            if isinstance(
                text,
                discord.TextChannel,
            ):

                try:

                    await text.set_permissions(
                        member,
                        view_channel=True,
                        send_messages=True,
                        read_message_history=True,
                    )

                except discord.HTTPException:
                    pass

                await send_profile(
                    member,
                    text,
                )

    # 退出
    if (
        before.channel
        and before.channel != after.channel
    ):

        room = get_room(
            before.channel.id
        )

        if room:

            text = member.guild.get_channel(
                room["text_id"]
            )

            if (
                isinstance(
                    text,
                    discord.TextChannel,
                )
                and member.id != room["owner_id"]
                and not is_admin(member)
            ):

                try:

                    await text.set_permissions(
                        member,
                        overwrite=None,
                    )

                except discord.HTTPException:
                    pass

            if len(
                before.channel.members
            ) == 0:

                await schedule_delete(
                    before.channel
                )


