            user_id
        )

        if not member:

            await interaction.response.send_message(
                "❌ メンバーが見つかりません。",
                ephemeral=True,
            )

            return

        voice = interaction.guild.get_channel(
            room["voice_id"]
        )

        text = interaction.channel

        if isinstance(
