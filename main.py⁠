class LimitSelect(
    discord.ui.Select,
):

    def __init__(self):

        options = [
            discord.SelectOption(
                label="2人",
                value="2",
            ),
            discord.SelectOption(
                label="3人",
                value="3",
            ),
            discord.SelectOption(
                label="4人",
                value="4",
            ),
            discord.SelectOption(
                label="5人",
                value="5",
            ),
            discord.SelectOption(
                label="6人",
                value="6",
            ),
        ]

        super().__init__(
            placeholder="人数制限を変更",
            options=options,
            custom_id="melty:room:limit",
        )

    async def callback(
        self,
        interaction: discord.Interaction,
    ):

        if not isinstance(
            interaction.channel,
            discord.TextChannel,
        ):
            return

        room = get_room_by_text(
            interaction.channel.id
        )

        if not room:
            await interaction.response.send_message(
                "❌ 部屋情報が見つかりません。",
                ephemeral=True,
            )
            return

        if not owner_or_admin(
            interaction.user,
            room,
        ):
            await interaction.response.send_message(
                "❌ 部屋主のみ操作できます。",
                ephemeral=True,
            )
            return

        if room["silent"]:
            await interaction.response.send_message(
                "🔇 無音部屋では人数制限変更を使用しません。",
                ephemeral=True,
            )
            return

        limit = int(
            self.values[0]
        )

        voice = interaction.guild.get_channel(
            room["voice_id"]
        )

        if isinstance(
            voice,
            discord.VoiceChannel,
        ):

            await voice.edit(
                user_limit=limit
            )

            update_room_limit(
                voice.id,
                limit,
            )

        await interaction.response.send_message(
            f"✅ 人数制限を **{limit}人** に変更しました。",
            ephemeral=True,
        )


