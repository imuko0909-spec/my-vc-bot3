async def delete_room(
    voice: discord.VoiceChannel,
):

    room = get_room(
        voice.id
    )

    if not room:
        return

    text = voice.guild.get_channel(
        room["text_id"]
    )

    try:

        if isinstance(
            text,
            discord.TextChannel,
        ):

            await text.delete(
                reason="Candy ルーム自動削除"
            )

    except discord.HTTPException:
        pass

    try:

        await voice.delete(
            reason="Candy ルーム自動削除"
        )

    except discord.HTTPException:
        pass

    delete_room_record(
        voice.id
    )


# =========================================================
# 空室15秒自動削除
# =========================================================

async def schedule_delete(
    voice: discord.VoiceChannel,
):

    old = delete_tasks.pop(
        voice.id,
        None,
    )

    if old:
        old.cancel()

    async def runner():

        try:

            await asyncio.sleep(
                EMPTY_DELETE_SECONDS
            )

            fresh = voice.guild.get_channel(
                voice.id
            )

            if (
                isinstance(
                    fresh,
                    discord.VoiceChannel,
                )
                and len(fresh.members) == 0
            ):

                await delete_room(
                    fresh
                )

        except asyncio.CancelledError:
            return

        finally:

            delete_tasks.pop(
                voice.id,
                None,
            )

    delete_tasks[
        voice.id
    ] = asyncio.create_task(
        runner()
    )


