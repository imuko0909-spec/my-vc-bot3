async def create_room(
    interaction: discord.Interaction,
    limit: int,
    silent: bool = False,
):

    if not interaction.guild:
        return

    if not interaction.response.is_done():

        await interaction.response.defer(
            ephemeral=True
        )

    member = interaction.user

    if not isinstance(
        member,
        discord.Member,
    ):
        return

    guild = interaction.guild

    existing = await get_owned_room(
        member
    )

    if existing:

        await interaction.followup.send(
            "⚠️ すでにあなたが作成したルームがあります。",
            ephemeral=True,
        )

        return

    category_id = (
        SILENT_CATEGORY_ID
        if silent
        else ROOM_CATEGORY_ID
    )

    category = guild.get_channel(
        category_id
    )

    if not isinstance(
        category,
        discord.CategoryChannel,
    ):

        await interaction.followup.send(
            "❌ 作成カテゴリーが見つかりません。",
            ephemeral=True,
        )

        return

    default_role = guild.default_role

    voice_overwrites = {
        default_role:
            discord.PermissionOverwrite(
                view_channel=True,
                connect=True,
                speak=False if silent else None,
            ),

        member:
            discord.PermissionOverwrite(
                view_channel=True,
                connect=True,
                speak=False if silent else True,
                manage_channels=True,
            ),
    }

    admin_role = guild.get_role(
        ADMIN_ROLE_ID
    )

    if admin_role:

        voice_overwrites[
            admin_role
        ] = discord.PermissionOverwrite(
            view_channel=True,
            connect=True,
            speak=True,
            manage_channels=True,
        )

    room_type = (
        "無音"
        if silent
        else f"{limit}人"
    )

    try:

        voice = await guild.create_voice_channel(
            name=f"🍬｜{member.display_name}・{room_type}",
            category=category,
            user_limit=(
                limit
                if not silent
                else 0
            ),
            overwrites=voice_overwrites,
            reason="Candy 少人数ルーム作成",
        )

    except discord.Forbidden:

        await interaction.followup.send(
            "❌ VCを作成できませんでした。\n"
            "Botの「チャンネル管理」権限を確認してください。",
            ephemeral=True,
        )

        return

    except discord.HTTPException as e:

        log.exception(
            "VC作成エラー：%s",
            e,
        )

        await interaction.followup.send(
            "❌ VC作成中にエラーが発生しました。",
            ephemeral=True,
        )

        return

    text_overwrites = {
        default_role:
            discord.PermissionOverwrite(
                view_channel=False,
            ),

        member:
            discord.PermissionOverwrite(
                view_channel=True,
                send_messages=True,
                read_message_history=True,
            ),
    }

    if guild.me:

        text_overwrites[
            guild.me
        ] = discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            manage_channels=True,
        )

    if admin_role:

        text_overwrites[
            admin_role
        ] = discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            manage_channels=True,
        )

    safe_name = re.sub(
        r"[^a-zA-Z0-9ぁ-んァ-ヶ一-龠_-]",
        "",
        member.display_name,
    )

    if not safe_name:
        safe_name = "room"

    try:

        text = await guild.create_text_channel(
            name=f"🍬-{safe_name}-room",
            category=category,
            overwrites=text_overwrites,
            reason="Candy 専用TC作成",
        )

    except discord.HTTPException as e:

        log.exception(
            "TC作成エラー：%s",
            e,
        )

        try:

            await voice.delete(
                reason="TC作成失敗のためVC削除"
            )

        except discord.HTTPException:
            pass

        await interaction.followup.send(
            "❌ 専用TCの作成に失敗しました。",
            ephemeral=True,
        )

        return

    save_room(
        voice.id,
        text.id,
        member.id,
        limit,
        silent,
    )

    moved = False

    if (
        member.voice
        and member.voice.channel
    ):

        try:

            await member.move_to(
                voice
            )

            moved = True

        except (
            discord.Forbidden,
            discord.HTTPException,
        ):
            moved = False

    embed = discord.Embed(
        title="🍬 Candy 少人数ROOM",
        description=(
            f"部屋主：{member.mention}\n"
            f"種類：**{room_type}ルーム**\n\n"
            "下のボタンからお部屋を操作できます✨"
        ),
        color=discord.Color.from_rgb(
            255,
            170,
            220,
        ),
    )

    if silent:

        embed.add_field(
            name="🔇 無音ルーム",
            value=(
                "このVCでは音声での会話はできません。\n"
                "この専用TCでチャットをお楽しみください。"
            ),
            inline=False,
        )

    await text.send(
        embed=embed,
        view=RoomControlView(),
    )

    if moved:

        message = (
            f"✅ {voice.mention} を作成し、"
            "自動で移動しました！"
        )

    else:

        message = (
            f"✅ {voice.mention} を作成しました！\n"
            "VCに入っていなくても部屋を作成できます🍬\n\n"
            "作成したVCをタップして入室してください。"
        )

    await interaction.followup.send(
        message,
        ephemeral=True,
    )

    await send_log(
        guild,
        (
            "🍬 **ルーム作成**\n"
            f"作成者：{member.mention}\n"
            f"ID：`{member.id}`\n"
            f"VC：{voice.name}\n"
            f"種類：{room_type}"
        ),
    )


