                "❌ 部屋主のみ操作できます。",
                ephemeral=True,
            )
            return

        voice = interaction.guild.get_channel(
            room["voice_id"]
        )

        if not isinstance(
            voice,
            discord.VoiceChannel,
        ):
            return

        locked = bool(
            room["locked"]
        )

        new_locked = not locked

        await voice.set_permissions(
            interaction.guild.default_role,
            view_channel=True,
            connect=False
            if new_locked
            else True,
            speak=False
            if room["silent"]
            else None,
        )

        update_room_lock(
            voice.id,
            new_locked,
        )

        await interaction.response.send_message(
            "🔒 部屋をロックしました。"
            if new_locked
            else "🔓 ロックを解除しました。",
            ephemeral=True,
        )

    @discord.ui.button(
        label="招待",
        emoji="➕",
        style=discord.ButtonStyle.success,
        custom_id="melty:room:invite",
    )
    async def invite(
