# =========================================================
# 管理者判定
# =========================================================

def is_admin(
    member: discord.Member,
) -> bool:

    if member.guild_permissions.administrator:
        return True

    return any(
        role.id == ADMIN_ROLE_ID
        for role in member.roles
    )


def owner_or_admin(
    member: discord.Member,
    room,
) -> bool:

    return (
        member.id == room["owner_id"]
        or is_admin(member)
    )


