class RenameModal(
    discord.ui.Modal,
    title="🍬 部屋名変更",
):

    room_name = discord.ui.TextInput(
        label="新しい部屋名",
        placeholder="例：まったり雑談",
        max_length=50,
    )

    async def on_submit(
        self,
        interaction: discord.Interaction,
    ):

        if not isinstance(
            interaction.channel,
            discord.TextChannel,
        ):
            return

        room = get_room_by_text(
            interaction.channel.id
        )

        if not room:

            await interaction.response.send_message(
                "❌ 部屋情報が見つかりません。",
                ephemeral=True,
            )

            return

        if not owner_or_admin(
            interaction.user,
            room,
        ):

            await interaction.response.send_message(
                "❌ 部屋主のみ変更できます。",
                ephemeral=True,
            )

            return

        voice = interaction.guild.get_channel(
            room["voice_id"]
        )

        if isinstance(
            voice,
            discord.VoiceChannel,
        ):

            await voice.edit(
                name=f"🍬｜{self.room_name.value}"
            )

        await interaction.response.send_message(
            "✅ 部屋名を変更しました。",
            ephemeral=True,
        )


