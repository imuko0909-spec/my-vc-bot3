    )
    async def clear_invites(
        self,
        interaction: discord.Interaction,
        button: discord.ui.Button,
    ):

        if not isinstance(
            interaction.channel,
            discord.TextChannel,
        ):
            return

        room = get_room_by_text(
            interaction.channel.id
        )

        if not room:

            await interaction.response.send_message(
                "❌ 部屋情報が見つかりません。",
                ephemeral=True,
            )

            return

        if not owner_or_admin(
            interaction.user,
            room,
        ):

            await interaction.response.send_message(
                "❌ 部屋主のみ操作できます。",
                ephemeral=True,
            )

            return

        guild = interaction.guild

        voice = guild.get_channel(
            room["voice_id"]
        )

        owner = guild.get_member(
            room["owner_id"]
        )

        if isinstance(
            voice,
            discord.VoiceChannel,
        ):

            for target in list(
                voice.overwrites.keys()
            ):

                if not isinstance(
                    target,
                    discord.Member,
                ):
                    continue

                if owner and target.id == owner.id:
                    continue

                if bot.user and target.id == bot.user.id:
                    continue

                try:

                    await voice.set_permissions(
                        target,
                        overwrite=None,
                    )

                except discord.HTTPException:
                    pass

        for target in list(
            interaction.channel.overwrites.keys()
        ):

            if not isinstance(
                target,
                discord.Member,
            ):
                continue

            if owner and target.id == owner.id:
                continue

            if bot.user and target.id == bot.user.id:
                continue

            try:

                await interaction.channel.set_permissions(
                    target,
                    overwrite=None,
                )

            except discord.HTTPException:
                pass

        await interaction.response.send_message(
            "✅ 個別招待を解除しました。",
            ephemeral=True,
        )

