async def find_profile_message(
    member: discord.Member,
) -> Optional[discord.Message]:

    guild = member.guild

    # -----------------------------------------
    # まずキャッシュ
    # -----------------------------------------

    cached = get_cached_profile(member.id)

    if cached:
        channel = guild.get_channel(cached["channel_id"])

        if isinstance(channel, discord.TextChannel):
            try:
                msg = await channel.fetch_message(
                    cached["message_id"]
                )

                if msg.author.id == member.id:
                    return msg

            except (
                discord.NotFound,
                discord.Forbidden,
                discord.HTTPException,
            ):
                pass

        clear_profile_cache(member.id)

    # -----------------------------------------
    # 男性 / 女性プロフィールから検索
    # -----------------------------------------

    channel_ids = [
        MALE_PROFILE_CHANNEL_ID,
        FEMALE_PROFILE_CHANNEL_ID,
    ]

    for channel_id in channel_ids:

        channel = guild.get_channel(channel_id)

        if not isinstance(channel, discord.TextChannel):
            continue

        try:
            async for message in channel.history(
                limit=1000,
                oldest_first=False,
            ):
                if message.author.id == member.id:

                    cache_profile(
                        member.id,
                        channel.id,
                        message.id,
                    )

                    return message

        except discord.Forbidden:
            log.warning(
                "プロフィールチャンネルを閲覧できません: %s",
                channel.id,
            )

        except discord.HTTPException:
            pass

    return None


