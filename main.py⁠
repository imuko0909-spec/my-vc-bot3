async def get_owned_room(
    member: discord.Member,
):

    with db_connect() as conn:

        row = conn.execute(
            """
            SELECT *
            FROM rooms
            WHERE owner_id = ?
            LIMIT 1
            """,
            (member.id,),
        ).fetchone()

    if not row:
        return None

    voice = member.guild.get_channel(
        row["voice_id"]
    )

    if voice is None:

        delete_room_record(
            row["voice_id"]
        )

        return None

    return row


