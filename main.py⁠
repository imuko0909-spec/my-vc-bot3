async def get_owned_room(
    member: discord.Member,
):

    with db_connect() as conn:
        row = conn.execute(
            """
            SELECT *
            FROM rooms
            WHERE owner_id = ?
            LIMIT 1
            """,
            (member.id,),
        ).fetchone()

    if not row:
        return None

    voice = member.guild.get_channel(
        row["voice_id"]
    )

    if voice is None:
        delete_room_record(row["voice_id"])
        return None

    return row


async def create_room(
    interaction: discord.Interaction,
    limit: int,
    silent: bool = False,
):

    if not interaction.guild:
        return

    member = interaction.user

    if not isinstance(member, discord.Member):
        return

    existing = await get_owned_room(member)

    if existing:

        await interaction.response.send_message(
            "⚠️ すでにあなたが作成した部屋があります。",
            ephemeral=True,
        )

        return

    if not member.voice or not member.voice.channel:

        await interaction.response.send_message(
            "🌙 先にどこかのVCへ入ってからボタンを押してください。",
            ephemeral=True,
        )

        return

    guild = interaction.guild

    category_id = (
        SILENT_CATEGORY_ID
        if silent
        else ROOM_CATEGORY_ID
    )

    category = guild.get_channel(category_id)

    if not isinstance(
        category,
        discord.CategoryChannel,
    ):
        await interaction.response.send_message(
            "❌ 作成カテゴリーが見つかりません。",
            ephemeral=True,
        )
        return

    await interaction.response.defer(
        ephemeral=True,
    )

    default_role = guild.default_role

    # -----------------------------------------
    # VC 権限
    # -----------------------------------------

    voice_overwrites = {
        default_role: discord.PermissionOverwrite(
            view_channel=True,
            connect=True,
            speak=False if silent else None,
        ),
        member: discord.PermissionOverwrite(
            view_channel=True,
            connect=True,
            speak=False if silent else True,
            manage_channels=True,
        ),
    }

    admin_role = guild.get_role(ADMIN_ROLE_ID)

    if admin_role:

        voice_overwrites[
            admin_role
        ] = discord.PermissionOverwrite(
            view_channel=True,
            connect=True,
            speak=True,
            manage_channels=True,
        )

    room_type = (
        "無音"
        if silent
        else f"{limit}人"
    )

    voice = await guild.create_voice_channel(
        name=f"🌙｜{member.display_name}・{room_type}",
        category=category,
        user_limit=limit if not silent else 0,
        overwrites=voice_overwrites,
        reason="Melty Moon 少人数ルーム作成",
    )

    # -----------------------------------------
    # 専用TC
    # -----------------------------------------

    text_overwrites = {
        default_role: discord.PermissionOverwrite(
            view_channel=False,
        ),
        member: discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
        ),
        guild.me: discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            manage_channels=True,
        ),
    }

    if admin_role:

        text_overwrites[
            admin_role
        ] = discord.PermissionOverwrite(
            view_channel=True,
            send_messages=True,
            read_message_history=True,
            manage_channels=True,
        )

    text = await guild.create_text_channel(
        name=f"🌙-{member.display_name}-room",
        category=category,
        overwrites=text_overwrites,
        reason="Melty Moon 専用TC作成",
    )

    save_room(
        voice.id,
        text.id,
        member.id,
        limit,
        silent,
    )

    # -----------------------------------------
    # 作成者を移動
    # -----------------------------------------

    try:
        await member.move_to(voice)
    except discord.HTTPException:
        pass

    # -----------------------------------------
    # TC案内
    # -----------------------------------------

    embed = discord.Embed(
        title="🌙 𝐦𝐞𝐥𝐭𝐲 𝐌𝐨𝐨𝐧 Room",
        description=(
            f"部屋主：{member.mention}\n"
            f"種類：**{room_type}ルーム**\n\n"
            "下のボタンから部屋を操作できます。"
        ),
        color=discord.Color.from_rgb(
            210,
            150,
            255,
        ),
    )

    if silent:

        embed.add_field(
            name="🔇 無音ルーム",
            value=(
                "このVCでは音声での会話はできません。\n"
                "この専用TCを使ってチャットしてください。"
            ),
            inline=False,
        )

    await text.send(
        embed=embed,
        view=RoomControlView(),
    )

    await interaction.followup.send(
        f"✅ {voice.mention} を作成しました！",
        ephemeral=True,
    )

    await send_log(
        guild,
        (
            f"🌙 ルーム作成\n"
            f"作成者: {member} ({member.id})\n"
            f"VC: {voice.name}\n"
            f"種類: {room_type}"
        ),
    )


