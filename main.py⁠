class InviteModal(
    discord.ui.Modal,
    title="🌙 メンバー招待",
):

    target = discord.ui.TextInput(
        label="ユーザーID または メンション",
        placeholder="例：123456789012345678",
        max_length=50,
    )

    async def on_submit(
        self,
        interaction: discord.Interaction,
    ):

        if not isinstance(
            interaction.channel,
            discord.TextChannel,
        ):
            return

        room = get_room_by_text(
            interaction.channel.id
        )

        if not room:
            await interaction.response.send_message(
                "❌ 部屋情報が見つかりません。",
                ephemeral=True,
            )
            return

        if not owner_or_admin(
            interaction.user,
            room,
        ):
            await interaction.response.send_message(
                "❌ 部屋主のみ操作できます。",
                ephemeral=True,
            )
            return

        ids = re.findall(
            r"\d{15,22}",
            self.target.value,
        )

        if not ids:
            await interaction.response.send_message(
                "❌ 正しいユーザーIDを入力してください。",
                ephemeral=True,
            )
            return

        user_id = int(ids[0])

        member = interaction.guild.get_member(
            user_id
        )

        if not member:
            await interaction.response.send_message(
                "❌ メンバーが見つかりません。",
                ephemeral=True,
            )
            return

        voice = interaction.guild.get_channel(
            room["voice_id"]
        )

        text = interaction.channel

        if isinstance(
            voice,
            discord.VoiceChannel,
        ):

            await voice.set_permissions(
                member,
                view_channel=True,
                connect=True,
                speak=False
                if room["silent"]
                else True,
            )

        await text.set_permissions(
            member,
            view_channel=True,
            send_messages=True,
            read_message_history=True,
        )

        await interaction.response.send_message(
            f"✅ {member.mention} を招待しました。",
            ephemeral=True,
        )


