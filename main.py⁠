def save_room(
    voice_id: int,
    text_id: int,
    owner_id: int,
    max_members: int,
    silent: bool,
    locked: bool = False,
):

    with db_connect() as conn:

        conn.execute(
            """
            INSERT OR REPLACE INTO rooms
            (
                voice_id,
                text_id,
                owner_id,
                max_members,
                silent,
                locked
            )
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                voice_id,
                text_id,
                owner_id,
                max_members,
                int(silent),
                int(locked),
            ),
        )

        conn.commit()


def get_room(
    voice_id: int,
):

    with db_connect() as conn:

        return conn.execute(
            """
            SELECT *
            FROM rooms
            WHERE voice_id = ?
            """,
            (voice_id,),
        ).fetchone()


